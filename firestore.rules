rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email != null;
    }

    // Products collection - Public read, Admin write
    match /products/{productId} {
      allow read: if true;  // Anyone can read products
      allow write: if isAdmin();  // Only admins can modify products
    }

    // Color swatches collection - Public read, Admin write
    match /colorSwatches/{colorId} {
      allow read: if true;  // Anyone can read color options
      allow write: if isAdmin();  // Only admins can modify colors
    }

    // Color swatches collection (alternative naming) - Public read, Admin write
    match /color_swatches/{colorId} {
      allow read: if true;  // Anyone can read color options
      allow write: if isAdmin();  // Only admins can modify colors
    }

    // Orders collection - Users can create and read their own, Admins can do everything
    match /orders/{orderId} {
      // Allow anyone to create new orders
      allow create: if true;

      // Allow users to read orders if they match customer info
      // Allow admins to read all orders
      allow read: if true;  // Public read for order tracking by ID

      // Only admins can update or delete orders
      allow update, delete: if isAdmin();

      // Order messages subcollection
      match /messages/{messageId} {
        // Anyone can read messages for an order
        allow read: if true;

        // Anyone can create messages (customers or admins)
        allow create: if true;

        // Only admins can update or delete messages
        allow update, delete: if isAdmin();
      }

      // Modification requests subcollection
      match /modificationRequests/{requestId} {
        // Anyone can read modification requests
        allow read: if true;

        // Anyone can create modification requests (customers)
        allow create: if true;

        // Admins can do everything
        allow update, delete: if isAdmin();

        // Customers can update specific fields only (for confirming/rejecting price adjustments)
        allow update: if !isAdmin() &&
                        // Only allow updating these specific fields
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['status', 'priceAdjustment']) &&
                        // Status can only change to these values
                        request.resource.data.status in ['approved', 'rejected_by_customer'] &&
                        // Ensure priceAdjustment exists and is being updated correctly
                        (request.resource.data.status == 'approved'
                          ? request.resource.data.priceAdjustment.customerConfirmedAt != null
                          : true) &&
                        (request.resource.data.status == 'rejected_by_customer'
                          ? request.resource.data.priceAdjustment.customerRejectedAt != null
                          : true);
      }
    }


    // Order messages collection (top-level, if used)
    match /orderMessages/{messageId} {
      // Anyone can read and create messages
      allow read, create: if true;

      // Only admins can update or delete messages
      allow update, delete: if isAdmin();
    }

    // Default deny all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
